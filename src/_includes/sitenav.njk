{# Navigation — a popover panel on mobile, opened by the header's hamburger (popovertarget="site-nav") #}
<nav class="site-nav" id="site-nav" popover aria-label="Main">
  <ul class="site-nav__list">
    {% for item in navigation %}

      {# Active link: exact match = this page; starts-with = inside this section (e.g. a blog post) #}
      {% if page.url == item.url %}
        {% set current = "page" %}
      {% elif item.url != "/" and page.url.startsWith(item.url) %}
        {% set current = "true" %}
      {% else %}
        {% set current = false %}
      {% endif %}

      <li>
        <a class="site-nav__link" href="{{ item.url }}"{% if current %} aria-current="{{ current }}"{% endif %}>{{ item.label }}</a>
      </li>

    {% else %}
      <li>No links yet</li> {# runs only if the list is empty #}
    {% endfor %}

    <li class="site-nav__phone">
      <a href="tel:{{ site.phone }}">{{ site.phoneDisplay }}</a>
    </li>
  </ul>
</nav>
