---
layout: base.njk
---

{# Defining Names #}
{% set banner = banner or banners[page.url] %}
{# ------------ #}

{# Skip Header #}
<a class="skip-link" href="#main">Skip to content</a>

{# Header — logo & sitenav #}
{% include "header.njk" %}

{# Main Content #}
<main id="main">

  {# Banner #}
  {% if banner %}
    {% include "banner.njk" %}
  {% endif %}

  {# Page Content #}
  {{ content | safe }}

</main>

{# Footer #}
{% include "footer.njk" %}

{# Scroll to Top Button #}
<button class="scroll-top" id="scroll-top" type="button" aria-label="Scroll to top">
  {% include "icons/arrow-circle-up-48.svg" %}
</button>