---
layout: page.njk
---
<article class="post">
  <header class="post__header">
    <a class="post__back" href="/blog/">← Back to Blog</a>
    <time datetime="{{ page.date.toISOString().split('T')[0] }}">{{ page.date | readableDate }}</time>
    <h1>{{ heading or title }}</h1>
  </header>

  {% if image %}
    <img class="post__image" src="{{ image }}" alt="{{ imageAlt }}">
  {% endif %}

  <div class="post__body">
    {{ content | safe }}
  </div>
</article>